# 이 파일은 견본입니다. 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# 값을 넣지 않는 항목은 = 뒤를 비워 두세요. 예시 번호를 남겨두면 진짜 값으로 취급되어 실패합니다.

# Meta Marketing API  (필수)
#   토큰   developers.facebook.com → 도구 → 그래프 API 탐색기
#          권한은 처음에 ads_read 만. 광고를 만들거나 끌 때 ads_management 를 추가.
#   계정ID Ads Manager 주소창의 act= 뒤 숫자
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# 광고를 실제로 만들 때(launch) 필요  — 그 전까지는 비워 두세요
META_PAGE_ID=
META_IG_ACCOUNT_ID=
META_PIXEL_ID=

# 카피·기획안 생성(breed)에 필요 — 그 전까지는 비워 두세요
ANTHROPIC_API_KEY=
